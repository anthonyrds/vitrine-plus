Options -MultiViews

RewriteEngine On
RewriteBase /

# ============================================================
# PROTECTION DES DONNÉES PRIVÉES
# ============================================================

RewriteRule ^\.data(?:/|$) - [F,L]
RewriteRule ^vitrine-data(?:/|$) - [F,L]

# ============================================================
# PROTECTION DE LA CONFIGURATION SMTP
# ============================================================

RewriteRule ^vitrine-mail-config\.php$ - [F,L]

# ============================================================
# PROTECTION DU COCKPIT ADMIN
# ============================================================
#
# /admin passe obligatoirement par admin-gate.php.
#
# Le PHP vérifie le Basic Auth AVANT de servir index.html.
#

RewriteRule ^admin/?$ admin-gate.php [L]

# ============================================================
# NE PAS RÉÉCRIRE LES VRAIS FICHIERS / DOSSIERS
# ============================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ============================================================
# SPA REACT
# ============================================================

RewriteRule ^ index.html [L]